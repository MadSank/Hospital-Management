# MedFlow HMS Environment Variables Template
ENVIRONMENT=development
DEBUG=True

# Backend API Configuration
API_V1_STR=/api
PROJECT_NAME="MedFlow Hospital Management System"

# Database (SQLite with WAL mode for local academic dev)
DATABASE_URL=sqlite:///./medflow.db

# Authentication / Security
SECRET_KEY=medflow-super-secure-jwt-signing-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
